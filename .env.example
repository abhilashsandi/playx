# ===========================================
# Distributed Automation Platform - Environment
# ===========================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/automation_platform?schema=public

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Encryption (for RabbitMQ message payloads) ---
ENCRYPTION_KEY=my-super-secret-key-change-in-production

# --- API Server ---
API_PORT=3000

# --- Vendor Site ---
VENDOR_SITE_URL=http://localhost:4201

# --- Browser Automation ---
# Set to "true" for headless mode (CI/production), "false" for visible browser (local dev)
BROWSER_HEADLESS=false

# --- Node Environment ---
NODE_ENV=development

# --- Debugging ---
# Slows down worker processing for easier debugging/observation (ms)
SIMULATED_DELAY_MS=0
