{
    "name": "api",
    "sourceRoot": "apps/api/src",
    "projectType": "application",
    "targets": {
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx ts-node -r tsconfig-paths/register apps/api/src/main.ts",
                "cwd": "."
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsc -p apps/api/tsconfig.json",
                "cwd": "."
            }
        }
    }
}