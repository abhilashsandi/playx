{
  "name": "@playx/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Automation Platform - Nx Monorepo",
  "scripts": {
    "start:api": "npx nx serve api",
    "start:worker": "npx nx serve worker",
    "start:frontend": "npx nx serve frontend",
    "start:vendor-site": "npx nx serve vendor-site",
    "build": "npx nx run-many --target=build --all",
    "db:generate": "npx prisma generate --schema=libs/database/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=libs/database/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=libs/database/prisma/schema.prisma",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.1",
    "inversify": "^6.2.1",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nx/js": "^20.3.3",
    "@nx/node": "^20.3.3",
    "@nx/react": "^20.3.3",
    "@nx/vite": "^20.3.3",
    "@nx/web": "^20.3.3",
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "nx": "^20.3.3",
    "prisma": "^6.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": "18.x"
  }
}